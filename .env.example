# Use python3 scripts/configure.py --telegram-user-id YOUR_NUMERIC_ID
# This example contains no usable credentials.
POSTGRES_PASSWORD=replace_with_generated_hex_password
API_TOKEN=replace_with_generated_random_token_at_least_32_characters
ALLOWED_TELEGRAM_USER_IDS=123456789
TELEGRAM_BOT_TOKEN=
# Optional trusted HTTPS relay to the Telegram Bot API (not an HTTP CONNECT proxy).
TELEGRAM_API_ROOT=https://api.telegram.org
# Keep loopback defaults for SSH access. For direct HTTP, use the password setup script.
WEB_ENABLED=false
WEB_PUBLIC=false
WEB_PASSWORD_HASH=
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,::1
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
